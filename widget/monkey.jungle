project.manifest = manifest.xml
project.typecheck = 0

# Only source/ holds code. Without this line the compiler takes every .mc file
# below the project root - a copy of the SDK, the source copies the simulator
# harness keeps in tools/simtest/work - and the build fails with "Redefinition"
# errors.
base.sourcePath = source

# ── Low-memory feature stripping ─────────────────────────────────────────────
# Devices whose *widget* memory limit is 64 KB cannot hold the full feature set:
# code+data alone occupies ~53 KB of the 64 KB budget, leaving too little heap
# for entities, HTTP responses and bitmaps (the app OOMs at runtime).
#
# Two build annotations select between a full and a lean implementation:
#   :fullmem — compiled everywhere except the 64 KB devices
#   :lowmem  — compiled ONLY on the 64 KB devices
#
# What the lean build drops (see Utils.mc / ViewController.mc / MenuController.mc):
#   * the mdi:* and device_class icon lookup tables  (~9.8 KB)
#   * EntityListView, leaving the classic EntityCardView (~4.1 KB)
#   * select/input_number editing (Menu2 picker, InputNumberEditView)
#   * date/time editing (DateTimeEditView, DateTimeValue) - those entities
#     are shown read-only, datetime.* in UTC
#   * the lock confirmation and PIN entry (Lock/)
#   * Wi-Fi/LTE execution (hass/WifiLte.mc) and the wait for the phone at
#     launch (ConnectionWait.mc)
#   * plain http to a loopback host (Client.isLoopbackHttpUrl())
#
# Verify with:  monkeyc ... -d instinct2x --build-stats 1 -r -O2
# ── Direct Wi-Fi ─────────────────────────────────────────────────────────────
# Edge head units keep Wi-Fi up outside a system sync whenever no activity is
# recording (their device models list wifiExclusions: ['fitRecording']), so a
# request can go out over it directly. Watches only have Wi-Fi up during a
# sync - and for a moment after one - so a "connected" Wi-Fi must not count as
# a connection there: it would end the launch wait and start requests over a
# link that drops when the sync ends. See hass/WifiLte.mc.
#   :directwifi   — compiled ONLY on the Edge units listed below
#   :nodirectwifi — compiled everywhere else
# Both are always paired with :fullmem. A new Edge model has to be added here;
# until then it gets the safe watch behaviour.
base.excludeAnnotations = lowmem;directwifi

edge1030.excludeAnnotations = lowmem;nodirectwifi
edge1030bontrager.excludeAnnotations = lowmem;nodirectwifi
edge1030plus.excludeAnnotations = lowmem;nodirectwifi
edge1040.excludeAnnotations = lowmem;nodirectwifi
edge1050.excludeAnnotations = lowmem;nodirectwifi
edge1060.excludeAnnotations = lowmem;nodirectwifi
edge530.excludeAnnotations = lowmem;nodirectwifi
edge540.excludeAnnotations = lowmem;nodirectwifi
edge550.excludeAnnotations = lowmem;nodirectwifi
edge830.excludeAnnotations = lowmem;nodirectwifi
edge840.excludeAnnotations = lowmem;nodirectwifi
edge850.excludeAnnotations = lowmem;nodirectwifi
edgemtb.excludeAnnotations = lowmem;nodirectwifi

descentg1.excludeAnnotations = fullmem;directwifi
enduro.excludeAnnotations = fullmem;directwifi
fenix5.excludeAnnotations = fullmem;directwifi
fenix5s.excludeAnnotations = fullmem;directwifi
fenix6.excludeAnnotations = fullmem;directwifi
fenix6s.excludeAnnotations = fullmem;directwifi
fenixchronos.excludeAnnotations = fullmem;directwifi
fr245.excludeAnnotations = fullmem;directwifi
fr55.excludeAnnotations = fullmem;directwifi
fr645.excludeAnnotations = fullmem;directwifi
fr935.excludeAnnotations = fullmem;directwifi
instinct2.excludeAnnotations = fullmem;directwifi
instinct2s.excludeAnnotations = fullmem;directwifi
instinct2x.excludeAnnotations = fullmem;directwifi
instinctcrossover.excludeAnnotations = fullmem;directwifi
venusq.excludeAnnotations = fullmem;directwifi
vivoactive3.excludeAnnotations = fullmem;directwifi

# ── Launcher icon variants ───────────────────────────────────────────────────
# The launcher icon (resources/drawables) is round: the Venu / vivoactive glance
# style draws it inside a circle, which a square icon's corners stick out of.
# Regenerate it from resources/logos/launcher-round.svg with
# tools/render_launcher_icon.swift.
#
# Non-square icon slot: the compiler would stretch the round icon into an oval,
# so these get a padded copy that keeps it round.
vivoactive3.resourcePath = $(vivoactive3.resourcePath);resources-launcher-40x33
vivoactive3m.resourcePath = $(vivoactive3m.resourcePath);resources-launcher-40x33
vivoactive3mlte.resourcePath = $(vivoactive3mlte.resourcePath);resources-launcher-40x33
etrextouch.resourcePath = $(etrextouch.resourcePath);resources-launcher-38x33
gpsmap67.resourcePath = $(gpsmap67.resourcePath);resources-launcher-38x33
