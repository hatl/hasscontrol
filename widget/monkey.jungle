project.manifest = manifest.xml
project.typecheck = 0

# ── Low-memory feature stripping ─────────────────────────────────────────────
# Devices whose *widget* memory limit is 64 KB cannot hold the full feature set:
# code+data alone occupies ~53 KB of the 64 KB budget, leaving too little heap
# for entities, HTTP responses and bitmaps (the app OOMs at runtime).
#
# Two build annotations select between a full and a lean implementation:
#   :fullmem — compiled everywhere except the 64 KB devices
#   :lowmem  — compiled ONLY on the 64 KB devices
#
# What the lean build drops (see Utils.mc / ViewController.mc / MenuController.mc):
#   * the mdi:* and device_class icon lookup tables  (~9.8 KB)
#   * EntityListView, leaving the classic EntityCardView (~4.1 KB)
#
# Verify with:  monkeyc ... -d instinct2x --build-stats 1 -r -O2
# (:daynight is excluded here as well - see "Day / Night display mode" below.)
base.excludeAnnotations = lowmem;daynight

descentg1.excludeAnnotations = fullmem;daynight
enduro.excludeAnnotations = fullmem;daynight
fenix5.excludeAnnotations = fullmem;daynight
fenix5s.excludeAnnotations = fullmem;daynight
fenix6.excludeAnnotations = fullmem;daynight
fenix6s.excludeAnnotations = fullmem;daynight
fenixchronos.excludeAnnotations = fullmem;daynight
fr245.excludeAnnotations = fullmem;daynight
fr55.excludeAnnotations = fullmem;daynight
fr645.excludeAnnotations = fullmem;daynight
fr935.excludeAnnotations = fullmem;daynight
instinct2.excludeAnnotations = fullmem;daynight
instinct2s.excludeAnnotations = fullmem;daynight
instinct2x.excludeAnnotations = fullmem;daynight
instinctcrossover.excludeAnnotations = fullmem;daynight
venusq.excludeAnnotations = fullmem;daynight
vivoactive3.excludeAnnotations = fullmem;daynight

# ── Launcher icon variants ───────────────────────────────────────────────────
# The launcher icon (resources/drawables) is round: the Venu / vivoactive glance
# style draws it inside a circle, which a square icon's corners stick out of.
# Regenerate it from resources/logos/launcher-round.svg with
# tools/render_launcher_icon.swift.
#
# Non-square icon slot: the compiler would stretch the round icon into an oval,
# so these get a padded copy that keeps it round.
vivoactive3.resourcePath = $(vivoactive3.resourcePath);resources-launcher-40x33
vivoactive3m.resourcePath = $(vivoactive3m.resourcePath);resources-launcher-40x33
vivoactive3mlte.resourcePath = $(vivoactive3mlte.resourcePath);resources-launcher-40x33
etrextouch.resourcePath = $(etrextouch.resourcePath);resources-launcher-38x33
gpsmap67.resourcePath = $(gpsmap67.resourcePath);resources-launcher-38x33

# ── Day / Night display mode ─────────────────────────────────────────────────
# Edge devices have a Day mode with a white background, so the glance text
# colour has to follow it (see AppGlance.mc):
#   :daynight   — compiled ONLY on these devices, follows the display mode
#   :darktheme  — compiled everywhere else, always white text
# None of these are 64 KB devices, so lowmem stays excluded.
edge1030.excludeAnnotations = lowmem;darktheme
edge1030bontrager.excludeAnnotations = lowmem;darktheme
edge1030plus.excludeAnnotations = lowmem;darktheme
edge1040.excludeAnnotations = lowmem;darktheme
edge1050.excludeAnnotations = lowmem;darktheme
edge1060.excludeAnnotations = lowmem;darktheme
edge520plus.excludeAnnotations = lowmem;darktheme
edge530.excludeAnnotations = lowmem;darktheme
edge540.excludeAnnotations = lowmem;darktheme
edge550.excludeAnnotations = lowmem;darktheme
edge820.excludeAnnotations = lowmem;darktheme
edge830.excludeAnnotations = lowmem;darktheme
edge840.excludeAnnotations = lowmem;darktheme
edge850.excludeAnnotations = lowmem;darktheme
edgeexplore.excludeAnnotations = lowmem;darktheme
edgeexplore2.excludeAnnotations = lowmem;darktheme
edgemtb.excludeAnnotations = lowmem;darktheme
